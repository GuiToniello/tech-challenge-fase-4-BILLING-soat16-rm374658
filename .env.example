POSTGRES_DB=oficina_billing
POSTGRES_USER=sa
POSTGRES_PASSWORD=P@ssw0rd123
POSTGRES_PORT=5434

API_BILLING_PORT=7196
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

ALLOWED_HOSTS=*
LOG_LEVEL_DEFAULT=Information
LOG_LEVEL_ASPNETCORE=Warning
DATABASE_CONNECTION_STRING=Host=postgres;Port=5432;Database=oficina_billing;Username=sa;Password=P@ssw0rd123

ELASTICMQ_PORT=9326
# Saga local com a Management e o OS Service: os tres servicos precisam do mesmo ElasticMQ (o da Management).
# Use SQS_SERVICE_URL=http://oficina-elasticmq:9324 e, depois do "compose up", ligue o container a rede da Management:
#   podman network connect tech-challenge-fase-4-management-soat16-rm374658_default oficina-billing-api
SQS_SERVICE_URL=http://elasticmq:9324

# Mercado Pago (Checkout Pro): sem access token a cobranca e simulada e o pagamento e aprovado na verificacao.
# A URL de notificacao precisa ser publica (ex.: {gatewayUrl}/billing/api/pagamentos/notificacoes); vazia, o status e conferido em /verificar.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_NOTIFICATION_URL=

# Resend (envio do orcamento por email); vazio: POST /enviar responde 400 (servico de email nao configurado)
RESEND_API_KEY=

REGISTRY_PREFIX=903936907231.dkr.ecr.us-east-1.amazonaws.com/
IMAGE_TAG=latest
