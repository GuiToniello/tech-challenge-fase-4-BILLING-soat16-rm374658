              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "var aprovacao = pm.response.json();",
                  "pm.test('Orcamento aguardando pagamento (2)', function () { pm.expect(aprovacao.orcamento.status).to.eql(2); });",
                  "pm.test('Cobranca pendente (1)', function () { pm.expect(aprovacao.pagamento.status).to.eql(1); });",
                  "pm.test('Link de pagamento', function () { pm.expect(aprovacao.pagamento.linkPagamento).to.match(/^https:\\/\\//); });",
                  "pm.test('Provedor informado', function () { pm.expect(['MercadoPago', 'Simulado']).to.include(aprovacao.pagamento.provedor); });",
                  "pm.collectionVariables.set('pagamento_id', aprovacao.pagamento.id);"
                ]
              }
            }
