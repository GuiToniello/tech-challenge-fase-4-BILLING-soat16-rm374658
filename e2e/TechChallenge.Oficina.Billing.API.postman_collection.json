                  "pm.test('Orcamento da OS', function () { pm.expect(pm.response.json().ordemServicoId).to.eql(pm.collectionVariables.get('os_id')); });",
                  "pm.test('Descricao do status', function () { pm.expect(pm.response.json().statusDescricao).to.eql('Gerado'); });"
                ]
              }
            }
          ],
          "request": {
