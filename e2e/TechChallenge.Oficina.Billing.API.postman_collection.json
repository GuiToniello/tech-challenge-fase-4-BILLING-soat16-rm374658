          "name": "Cadastrar Cliente Base na Management (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function gerarCpfValido() {",
                  "  const base = [];",
                  "  for (let i = 0; i < 9; i++) base.push(Math.floor(Math.random() * 10));",
                  "  let soma = 0;",
                  "  for (let i = 0; i < 9; i++) soma += base[i] * (10 - i);",
                  "  let resto = soma % 11;",
                  "  const d1 = resto < 2 ? 0 : 11 - resto;",
                  "  soma = 0;",
                  "  for (let i = 0; i < 9; i++) soma += base[i] * (11 - i);",
                  "  soma += d1 * 2;",
                  "  resto = soma % 11;",
                  "  const d2 = resto < 2 ? 0 : 11 - resto;",
                  "  return [...base, d1, d2].join('');",
                  "}",
                  "function gerarPlacaMercosul() {",
                  "  const letras = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';",
                  "  const digitos = '0123456789';",
                  "  return letras[Math.floor(Math.random() * 26)] + letras[Math.floor(Math.random() * 26)] + letras[Math.floor(Math.random() * 26)] +",
                  "    digitos[Math.floor(Math.random() * 10)] + letras[Math.floor(Math.random() * 26)] +",
                  "    digitos[Math.floor(Math.random() * 10)] + digitos[Math.floor(Math.random() * 10)];",
                  "}",
                  "function gerarDigitos(tamanho) {",
                  "  let valor = '';",
                  "  for (let i = 0; i < tamanho; i++) valor += Math.floor(Math.random() * 10);",
                  "  return valor;",
                  "}",
                  "pm.collectionVariables.set('os_sufixo', Date.now().toString().slice(-6));",
                  "pm.collectionVariables.set('cliente_identificacao', gerarCpfValido());",
                  "pm.collectionVariables.set('veiculo_placa', gerarPlacaMercosul());",
                  "pm.collectionVariables.set('veiculo_renavam', gerarDigitos(11));",
                  "['cliente_id', 'veiculo_id', 'insumo_id', 'servico_id', 'os_id', 'os_recusa_id', 'pagamento_id', 'pagamento_status'].forEach(function (nome) { pm.collectionVariables.unset(nome); });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('cliente_id', pm.response.json().id);"
                ]
              }
            }
          ],
