    {
      "name": "Orcamentos",
      "description": "Ciclo do orcamento: gerar (snapshot da OS validada pela Management), enviar por email, aprovar (cria a cobranca com link de pagamento) e recusar, alem dos erros 400 e 404.",
      "item": [
        {
          "name": "01 - Gerar Orcamento (200)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// O Billing precisa ter recebido o OrdemServicoValidada da Management",
                  "// A saga e assincrona (filas SQS): espera os outros servicos consumirem os eventos antes da proxima requisicao",
                  "const espera = Number(pm.variables.get('tempo_espera_ms') || 3000);",
                  "setTimeout(function () {}, espera);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "var orcamento = pm.response.json();",
                  "pm.test('Status gerado (1)', function () { pm.expect(orcamento.status).to.eql(1); });",
                  "pm.test('Valor total calculado', function () { pm.expect(orcamento.valorTotal).to.be.a('number').and.above(0); });",
                  "pm.test('Servicos do snapshot', function () { pm.expect(orcamento.servicos).to.be.an('array').and.not.empty; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orcamentos/{{os_id}}/gerar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orcamentos",
                "{{os_id}}",
                "gerar"
              ]
            }
          }
        },
