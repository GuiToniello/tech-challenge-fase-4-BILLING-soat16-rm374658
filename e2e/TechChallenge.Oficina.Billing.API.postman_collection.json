    {
      "name": "Pagamentos",
      "description": "Cobranca do orcamento aprovado: consulta, verificacao no provedor (Mercado Pago ou simulado, que aprova na hora) e o webhook de notificacoes, anonimo e sempre 200.",
      "item": [
        {
          "name": "01 - Obter Pagamento da OS (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Cobranca criada na aprovacao', function () { pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('pagamento_id')); });",
                  "pm.test('Link de pagamento', function () { pm.expect(pm.response.json().linkPagamento).to.be.a('string').and.not.empty; });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pagamentos/{{os_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pagamentos",
                "{{os_id}}"
              ]
            }
          }
        },
        {
          "name": "02 - Verificar Pagamento (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "var pagamento = pm.response.json();",
                  "// Simulado: aprovado na verificacao. Mercado Pago: segue pendente ate o cliente pagar pelo link",
                  "pm.test('Status pendente (1) ou aprovado (2)', function () { pm.expect([1, 2]).to.include(pagamento.status); });",
                  "if (pagamento.provedor === 'Simulado') {",
                  "  pm.test('Pagamento simulado aprovado (2)', function () { pm.expect(pagamento.status).to.eql(2); });",
                  "}",
                  "pm.collectionVariables.set('pagamento_status', String(pagamento.status));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pagamentos/{{os_id}}/verificar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pagamentos",
                "{{os_id}}",
                "verificar"
              ]
            }
          }
        },
        {
          "name": "03 - Verificar Novamente (200, idempotente)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Mesmo pagamento', function () { pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('pagamento_id')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pagamentos/{{os_id}}/verificar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pagamentos",
                "{{os_id}}",
                "verificar"
              ]
            }
          }
        },
        {
          "name": "04 - Obter Orcamento apos Pagamento (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.collectionVariables.get('pagamento_status') === '2') {",
                  "  pm.test('Orcamento aprovado (3) com o pagamento confirmado', function () { pm.expect(pm.response.json().status).to.eql(3); });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orcamentos/{{os_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
