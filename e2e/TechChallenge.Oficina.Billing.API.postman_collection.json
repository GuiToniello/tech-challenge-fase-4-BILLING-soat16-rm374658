                "{{os_id}}"
              ]
            }
          }
        },
        {
          "name": "05 - Acompanhamento da OS no OS Service (200)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// O OS Service recebe o PagamentoAprovado pela fila SQS",
                  "// A saga e assincrona (filas SQS): espera os outros servicos consumirem os eventos antes da proxima requisicao",
                  "const espera = Number(pm.variables.get('tempo_espera_ms') || 3000);",
                  "setTimeout(function () {}, espera);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.collectionVariables.get('pagamento_status') === '2') {",
                  "  pm.test('OS em execucao (4) apos o PagamentoAprovado', function () { pm.expect(pm.response.json().status).to.eql(4); });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
